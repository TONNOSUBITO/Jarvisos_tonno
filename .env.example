# Copia in .env (mai committato). Solo nomi e valori d'esempio NON segreti.

# Percorso del file di configurazione del dispositivo (default: config/device.toml)
JARVIS_CONFIG=config/device.toml

# Percorso di un Chromium già installato, se `playwright install chromium` non è usabile
# JARVIS_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Chiavi dei provider di modelli (facoltative). Il nome coincide con api_key_env in config/providers.example.toml.
# Quelle lasciate vuote o commentate vengono saltate.
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# COHERE_API_KEY=
# HF_TOKEN=
# NVIDIA_API_KEY=
# TOGETHER_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# FIREWORKS_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
